# =============================================================================
# users-pro — Local account lifecycle management for Ubuntu 26.04 LTS.
# Usage: users-pro <command> [options]     |     users-pro tui
# =============================================================================

set -Eeuo pipefail


SCRIPT_NAME=$(basename -- "${BASH_SOURCE[0]}")
readonly SCRIPT_NAME


trap 'core_cleanup' EXIT
# FIX: the original set -E without ever installing an ERR trap, so the flag was
# inert and unexpected failures produced a bare exit code with no location.
# BASH_SOURCE/LINENO inside a trap string report the trap itself, which is
# useless. BASH_COMMAND names the command that actually failed.
trap 'trap_rc=$?; trap - ERR; log_error "Unhandled failure: ${BASH_COMMAND} (exit ${trap_rc})"; exit "$trap_rc"' ERR

# =============================================================================
# Table-driven option parsing
# =============================================================================
# Replaces ~450 lines of copy-pasted case arms. Each command declares a spec of
# "name:kind" where kind is `value` or `flag`; results land in OPT[<name>].

declare -A OPT=()
declare -a POSITIONAL=()

parse_options() {
  local spec_name=$1; shift
  local -n _spec=$spec_name
  local -A kind=() alias=()
  local entry key k a

  for entry in "${_spec[@]}"; do
    key=${entry%%:*}
    k=${entry#*:}
    if [[ $k == *:* ]]; then
      a=${k#*:}; k=${k%%:*}
      for a in ${a//,/ }; do alias[$a]=$key; done
    fi
    kind[$key]=$k
  done

  OPT=()
  POSITIONAL=()

  while (( $# > 0 )); do
    local arg=$1 name="" value="" has_value=no
    case $arg in
      --) shift; POSITIONAL+=("$@"); break ;;
      --*=*) name=${arg%%=*}; name=${name#--}; value=${arg#*=}; has_value=yes ;;
      --*)   name=${arg#--} ;;
      -?)    name=${alias[$arg]:-} ; [[ -n $name ]] || die "-$EX_USAGE" "Unknown option: $arg" ;;
      *)     POSITIONAL+=("$arg"); shift; continue ;;
    esac

    [[ -n ${kind[$name]:-} ]] || die "-$EX_USAGE" "Unknown option for '${CURRENT_COMMAND}': ${arg}"

    if [[ ${kind[$name]} == value ]]; then
      if [[ $has_value == no ]]; then
        (( $# >= 2 )) || die "-$EX_USAGE" "Option '${arg}' requires a value."
        value=$2
        shift
      fi
      OPT[$name]=$value
      OPT[__set_${name}]=1
    else
      [[ $has_value == yes ]] && die "-$EX_USAGE" "Option '--${name}' does not take a value."
      OPT[$name]=yes
      OPT[__set_${name}]=1
    fi
    shift
  done
}

opt() { printf '%s' "${OPT[$1]:-${2:-}}"; }
opt_set() { [[ -n ${OPT[__set_$1]:-} ]]; }
opt_flag() { [[ ${OPT[$1]:-no} == yes ]]; }

# Global flags every command understands.
readonly GLOBAL_SPEC_ENTRIES=(
  "dry-run:flag:-n" "yes:flag:-y" "quiet:flag:-q" "verbose:flag:-v"
  "json:flag" "help:flag:-h" "no-color:flag" "audit-log:value"
)

apply_global_options() {
  opt_flag dry-run && DRY_RUN=true
  opt_flag yes && ASSUME_YES=true
  opt_flag quiet && QUIET=true
  opt_flag verbose && VERBOSE=true
  opt_flag json && JSON_OUTPUT=true
  opt_set audit-log && AUDIT_LOG=$(opt audit-log)
  return 0
}

